// User -------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  timezone     String   @default("UTC")
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Events created by the host
  events Event[]

  // Bookings made by this user
  bookings Booking[] @relation("AttendeeBookings")

  // Bookings hosted by this user
  hostedBookings Booking[] @relation("HostedBookings")
}
