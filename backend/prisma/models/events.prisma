// Event -------------------------------------
model Event {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  description     String?
  durationMinutes Int      @default(30)
  meetingLink     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, slug])
}
